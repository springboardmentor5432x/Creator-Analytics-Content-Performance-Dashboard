# Easy local development uses SQLite by default. For PostgreSQL, uncomment and edit:
# DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/creator_iq
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated email addresses allowed to register as Admin
ADMIN_EMAILS=admin@example.com
