# PostgreSQL connection (required for persistent multi-user deployment)
DATABASE_URL=postgresql+psycopg://postgres:puji%4013@localhost:5432/content_intelligence
# Generate a long random secret; never commit real secrets
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=10080
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
# Google Cloud OAuth credentials; enable YouTube Data API v3 and YouTube Analytics API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/oauth/youtube/callback
