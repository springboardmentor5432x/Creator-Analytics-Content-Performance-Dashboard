# Copy to .env and edit
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/creatoriq
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:5173
# Creates the 4 demo users on startup. Set to false in any real deployment.
SEED_DEMO_USERS=true
# Optional YouTube Data API v3 key for live channel sync (leave empty for automatic mock/demo sync)
YOUTUBE_API_KEY=
