# Copy to .env. Never commit real credentials.
FRONTEND_ORIGIN=http://localhost:5173
PORT=5000
FLASK_DEBUG=false
FLASK_SECRET_KEY=replace-with-a-long-random-secret
TOKEN_DB_PATH=creatorhub_tokens.sqlite3

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/oauth/youtube/callback

# Instagram and TikTok adapters are not yet implemented. Keep credentials server-side only.
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
