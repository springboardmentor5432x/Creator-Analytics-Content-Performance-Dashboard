# Development example only. Never commit your real .env file.
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000

# Generate a unique 64+ character JWT secret for each environment.
JWT_SECRET_KEY=GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRE_MINUTES=20
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Set COOKIE_DOMAIN only when you intentionally share cookies across subdomains.
# COOKIE_DOMAIN=.example.com

# Local development may use SQLite. Production must use private PostgreSQL with TLS.
DATABASE_URL=sqlite:///./creatorhub_dev.db
# Production example:
# DATABASE_URL=postgresql+psycopg2://APP_USER:URL_ENCODED_PASSWORD@PRIVATE_DB_HOST:5432/creatorhub?sslmode=verify-full

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Required for production shared rate limiting. Use Redis private endpoint / TLS (rediss://).
# REDIS_URL=rediss://:PASSWORD@PRIVATE_REDIS_HOST:6379/0

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/oauth/youtube/callback

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/oauth/spotify/callback

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
