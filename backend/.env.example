# Match the secret used by your existing CreatorIQ JWT login implementation.
JWT_SECRET_KEY=replace-with-the-existing-creatoriq-jwt-secret
JWT_ALGORITHM=HS256

# Used to sign and validate OAuth state. Use a separate long random secret.
OAUTH_STATE_SECRET=replace-with-a-long-random-secret
SOCIAL_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key

FRONTEND_DASHBOARD_URL=http://localhost:5173/dashboard
BACKEND_PUBLIC_URL=http://localhost:8000

# Google / YouTube OAuth (create credentials in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Meta OAuth (create an app in Meta for Developers)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
