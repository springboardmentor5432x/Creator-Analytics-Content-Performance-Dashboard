# Local FastAPI environment. Copy to .env and add credentials only for providers you configure.
APP_NAME=CreatorIQ API
API_PREFIX=/api
DATABASE_URL=sqlite:///./creatoriq.db
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=true
FRONTEND_BASE_URL=http://localhost:5173

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_ENCRYPTION_KEY=

# YouTube OAuth and public Data API
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8001/api/integrations/youtube/callback
YOUTUBE_API_KEY=

# Meta app: Facebook Pages + Instagram (Unified Login)
# META_OAUTH_* values can also be supplied as FB_APP_ID / FB_APP_SECRET.
META_OAUTH_CLIENT_ID=
META_OAUTH_CLIENT_SECRET=
META_GRAPH_API_VERSION=v26.0

# Facebook Login for Business (optional). Without it, standard Facebook
# Login requests pages_show_list and pages_read_engagement directly.
FACEBOOK_OAUTH_CONFIG_ID=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:8001/api/integrations/facebook/callback

# Instagram API with Unified Login (Instagram Login compatible configuration).
# The redirect URL saved in the Meta app configuration must match this exactly.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CONFIG_ID=
INSTAGRAM_REDIRECT_URI=http://localhost:8001/api/integrations/instagram/callback

# X API v2
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8001/api/integrations/x/callback

# LinkedIn (requires approved products/scopes)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8001/api/integrations/linkedin/callback
LINKEDIN_OAUTH_SCOPES=openid profile email w_member_social
LINKEDIN_API_VERSION=202610

HTTP_TIMEOUT_SECONDS=20
