# Copy this file to ".env" and fill in your own values. Never commit ".env".

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# SQLite (default, zero setup for development):
DATABASE_URL=sqlite:///./creatoriq.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/creatoriq

# -----------------------------------------------------------------------------
# Security & JWT Configuration
# -----------------------------------------------------------------------------
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Production Environment Safety Flags
ENVIRONMENT=development
# Set ALLOW_DEV_ADMIN_REGISTRATION=false in production to disallow public self-registration of Admin accounts
ALLOW_DEV_ADMIN_REGISTRATION=true

# Used only by `python -m app.seed` to create demo accounts (choose your own)
DEMO_PASSWORD=choose-a-demo-password-here

# -----------------------------------------------------------------------------
# Social Platform Integration Credentials (OAuth 2.0)
# -----------------------------------------------------------------------------
# YouTube Data API v3 (Google Cloud Console OAuth 2.0 Web Client)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5173/connections/youtube/callback
YOUTUBE_API_KEY=

# Meta / Instagram Graph API v26.0 (Meta for Developers Facebook Login App)
META_GRAPH_API_VERSION=v26.0
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5173/connections/instagram/callback

# Future / Planned Platform Credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
