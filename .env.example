# ==============================================================================
# CreatorIQ – Creator Analytics & Content Performance Dashboard
# Firebase Configuration Environment Variables
# ==============================================================================
# Instructions:
# 1. Create a copy of this file named ".env" in the root directory.
# 2. Go to the Firebase Console: https://console.firebase.google.com/
# 3. Create or select your project: "CreatorIQ"
# 4. Enable Authentication (Email/Password and Google providers).
# 5. Enable Firestore Database (test or production rules).
# 6. Go to Project Settings -> General -> Your apps -> Web app -> SDK setup and configuration.
# 7. Replace the placeholder values below with your project credentials.
# ==============================================================================

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ==============================================================================
# YouTube Social Integration (Google OAuth 2.0 & YouTube Data/Analytics APIs)
# ==============================================================================
# Instructions:
# 1. Open Google Cloud Console: https://console.cloud.google.com/
# 2. Enable "YouTube Data API v3" and "YouTube Analytics API"
# 3. In Credentials -> Create Credentials -> OAuth client ID (Web application)
#    - Authorized origin: http://localhost:5173
#    - Authorized redirect URI: http://localhost:5173/api/auth/youtube/callback
# 4. Paste your Client ID and Client Secret below:
# ==============================================================================
YOUTUBE_CLIENT_ID=your_youtube_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:5173/api/auth/youtube/callback
YOUTUBE_API_KEY=your_optional_youtube_api_key
