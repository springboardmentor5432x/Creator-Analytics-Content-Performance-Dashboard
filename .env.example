# Root-level environment variables used by docker compose. Copy to .env.
# Generate a Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET_KEY=replace-with-a-long-random-secret
OAUTH_TOKEN_ENCRYPTION_KEY=
FRONTEND_BASE_URL=http://localhost:4173
CORS_ORIGINS=http://localhost:4173,http://localhost:5173
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/youtube/callback
YOUTUBE_API_KEY=
META_OAUTH_CLIENT_ID=
META_OAUTH_CLIENT_SECRET=
META_GRAPH_API_VERSION=v26.0

# Instagram Unified Login (separate Meta app)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CONFIG_ID=
INSTAGRAM_REDIRECT_URI=https://your-public-url/api/integrations/instagram/callback

FACEBOOK_OAUTH_CONFIG_ID=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/facebook/callback

# X API v2
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/integrations/x/callback

# LinkedIn API (requires registered callback and approved product scopes)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/integrations/linkedin/callback
LINKEDIN_OAUTH_SCOPES=openid profile email r_member_postAnalytics r_member_profileAnalytics r_member_social
LINKEDIN_API_VERSION=202610
